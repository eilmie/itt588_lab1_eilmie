<div class="login-container">
  <h2>System Login</h2>

  <!-- Notification Handling -->
  <% if flash[:error] %>
    <div class="alert alert-error"><%= flash[:error] %></div>
  <% end %>
  <% if flash[:notice] %>
    <div class="alert alert-success"><%= flash[:notice] %></div>
  <% end %>

  <!-- Dashboard / Authenticated View -->
  <% if session[:user_id] %>
    <div class="welcome-box">
      <p>You are currently logged in as <strong><%= session[:user_id] %></strong>.</p>
      <%= button_to "Logout", logout_path, method: :delete, class: "btn-logout" %>
    </div>
  
  <!-- Login Form / Unauthenticated View -->
  <% else %>
    <%= form_tag login_path, method: :post, class: "login-form" do %>
      <div class="form-group">
        <%= label_tag :username, "Username" %>
        <%= text_field_tag :username, nil, placeholder: "Enter username", required: true %>
      </div>
      <div class="form-group">
        <%= label_tag :password, "Password" %>
        <%= password_field_tag :password, nil, placeholder: "Enter password", required: true %>
      </div>
      <div class="form-actions">
        <%= submit_tag "Login", class: "btn-submit" %>
      </div>
    <% end %>
  <% end %>
</div>

<style>
  body { font-family: 'Segoe UI', Tahoma, sans-serif; background-color: #f4f7f6; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
  .login-container { background: white; padding: 40px; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); width: 100%; max-width: 400px; }
  h2 { text-align: center; color: #333; margin-bottom: 20px; }
  .form-group { margin-bottom: 15px; }
  .form-group label { display: block; margin-bottom: 5px; color: #666; font-weight: bold; }
  .form-group input { width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box; }
  .btn-submit { width: 100%; padding: 10px; background-color: #cc0000; color: white; border: none; border-radius: 4px; font-size: 16px; cursor: pointer; transition: background 0.3s; }
  .btn-submit:hover { background-color: #990000; }
  .btn-logout { background-color: #555; color: white; padding: 8px 15px; border: none; border-radius: 4px; cursor: pointer; margin-top: 15px; }
  .alert { padding: 10px; margin-bottom: 20px; border-radius: 4px; text-align: center; }
  .alert-error { background-color: #ffe6e6; color: #cc0000; border: 1px solid #ffcccc; }
  .alert-success { background-color: #e6ffe6; color: #008000; border: 1px solid #ccffcc; }
  .welcome-box { text-align: center; }
</style>